{
  "name": "qt-hrms-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QT Consultancy HRMS API: recruitment, attendance, leave, resignation, targets, master data and policy.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup-face-models": "node scripts/download-models-v2.js",
    "migrate": "node src/cli/migrate.js",
    "migrate:reset": "node src/cli/migrate.js --reset",
    "seed": "node src/cli/seed.js",
    "create-admin": "node src/cli/create-admin.js",
    "db:create": "node src/cli/db-create.js",
    "test": "node src/cli/migrate.js --reset && node src/cli/seed.js --force && node --test --test-concurrency=1 --test-force-exit \"test/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
