# QT Consultancy HRMS uses this local PostgreSQL instance. No Docker.
# Copy to .env, then run:
#   npm run db:create && npm run migrate
# For a DEMO database add:  npm run seed
# For PRODUCTION add:        ADMIN_NAME="..." ADMIN_LOGIN_ID="..." npm run create-admin

# Created by `npm run db:create`, which prints the exact line to paste here.
DATABASE_URL=postgres://hrms:change-me@localhost:5432/hrms

PORT=3000
ORIGIN=http://localhost:3000

# Browsers only expose the camera on https or localhost. To mark attendance /
# enroll a face from another device (phone / shared PC) on the LAN, the server
# also listens for TLS on this port using a self-signed cert in server/certs.
# Open https://<this-machine-lan-ip>:3443 on the other device and accept the
# one-time certificate warning. See FACE-RECOGNITION-SETUP.md.
HTTPS_PORT=3443
CERT_DIR=

# Required in production. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# The portal is served from the project root by the same process.
SERVE_UI=true

# Uploaded recruit documents. Defaults to server/uploads
UPLOAD_DIR=

# Optional face-recognition tuning (sane defaults are used if unset).
# FACE_MATCH_MAX_DISTANCE  accept when Euclidean distance <= this (default 0.5)
# ENROLL_MIN_SCORE         reject an enrollment sample below this detection score (default 0.6)
